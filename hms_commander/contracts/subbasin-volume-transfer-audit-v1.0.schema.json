{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hms-commander/subbasin-volume-transfer-audit/1.0",
  "title": "HMS Commander subbasin volume transfer audit 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "method",
    "algorithm",
    "transfer_map_sha256",
    "source",
    "model_window",
    "volume_tolerance",
    "prepublication_volume",
    "published_volume",
    "readback",
    "audit_sha256"
  ],
  "properties": {
    "schema": {"const": "hms-commander/subbasin-volume-transfer-audit/1.0"},
    "method": {"const": "hms-subbasin-volume-conserving-v1"},
    "algorithm": {
      "const": "target-center-subbasin-coverage-effective-area-scaling-v1"
    },
    "transfer_map_sha256": {"$ref": "#/$defs/sha256"},
    "source": {"$ref": "#/$defs/source"},
    "model_window": {"$ref": "#/$defs/modelWindow"},
    "volume_tolerance": {"$ref": "#/$defs/tolerance"},
    "prepublication_volume": {"$ref": "#/$defs/volumeEvidence"},
    "published_volume": {"$ref": "#/$defs/volumeEvidence"},
    "readback": {"$ref": "#/$defs/readback"},
    "audit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_dss",
        "a_part",
        "run_name",
        "parameter",
        "units",
        "data_type",
        "interval_minutes",
        "timestamp_semantics",
        "series"
      ],
      "properties": {
        "source_dss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "size_bytes", "sha256", "integrity_verification"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
            "size_bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "integrity_verification": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pre_read", "post_read", "status"],
              "properties": {
                "pre_read": {"type": "array", "items": {"type": "string"}},
                "post_read": {"type": "array", "items": {"type": "string"}},
                "status": {"const": "unchanged"}
              }
            }
          }
        },
        "a_part": {"type": "string"},
        "run_name": {"type": "string", "minLength": 1},
        "parameter": {"const": "PRECIP-EXCESS"},
        "units": {"enum": ["IN", "MM"]},
        "data_type": {"const": "PER-CUM"},
        "interval_minutes": {"type": "integer", "minimum": 1},
        "timestamp_semantics": {"const": "interval_end"},
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subbasin",
              "pathname_family",
              "catalog_pathnames",
              "read_pathname",
              "value_sha256",
              "value_count"
            ],
            "properties": {
              "subbasin": {"type": "string", "minLength": 1},
              "pathname_family": {
                "type": "object",
                "additionalProperties": false,
                "required": ["a_part", "b_part", "c_part", "e_part", "f_part"],
                "properties": {
                  "a_part": {"type": "string"},
                  "b_part": {"type": "string", "minLength": 1},
                  "c_part": {"const": "PRECIP-EXCESS"},
                  "e_part": {"type": "string", "minLength": 1},
                  "f_part": {"type": "string", "minLength": 1}
                }
              },
              "catalog_pathnames": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 7}
              },
              "read_pathname": {"type": "string", "minLength": 7},
              "value_sha256": {"$ref": "#/$defs/sha256"},
              "value_count": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "modelWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "interval_minutes", "step_count", "timestamp_semantics"],
      "properties": {
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1},
        "interval_minutes": {"type": "integer", "minimum": 1},
        "step_count": {"type": "integer", "minimum": 1},
        "timestamp_semantics": {"const": "interval_end"}
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute_cubic_meters", "relative_fraction"],
      "properties": {
        "absolute_cubic_meters": {"type": "number", "minimum": 0},
        "relative_fraction": {"type": "number", "minimum": 0}
      }
    },
    "residual": {
      "type": "object",
      "required": [
        "source_cubic_meters",
        "target_cubic_meters",
        "residual_cubic_meters",
        "absolute_residual_cubic_meters",
        "relative_residual_fraction",
        "allowed_residual_cubic_meters"
      ],
      "properties": {
        "source_cubic_meters": {"type": "number"},
        "target_cubic_meters": {"type": "number"},
        "residual_cubic_meters": {"type": "number"},
        "absolute_residual_cubic_meters": {"type": "number", "minimum": 0},
        "relative_residual_fraction": {"type": ["number", "null"], "minimum": 0},
        "allowed_residual_cubic_meters": {"type": "number", "minimum": 0}
      }
    },
    "volumeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_step", "per_subbasin", "aggregate"],
      "properties": {
        "per_step": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/residual"},
              {
                "type": "object",
                "required": ["interval_end"],
                "properties": {"interval_end": {"type": "string", "minLength": 1}}
              }
            ]
          }
        },
        "per_subbasin": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/residual"},
              {
                "type": "object",
                "required": ["subbasin", "maximum_step_absolute_residual_cubic_meters"],
                "properties": {
                  "subbasin": {"type": "string", "minLength": 1},
                  "maximum_step_absolute_residual_cubic_meters": {"type": "number", "minimum": 0}
                }
              }
            ]
          }
        },
        "aggregate": {
          "allOf": [
            {"$ref": "#/$defs/residual"},
            {
              "type": "object",
              "required": ["maximum_step_absolute_residual_cubic_meters"],
              "properties": {
                "maximum_step_absolute_residual_cubic_meters": {"type": "number", "minimum": 0}
              }
            }
          ]
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "absolute_value_tolerance",
        "maximum_absolute_value_difference",
        "weighted_depth_area_by_support"
      ],
      "properties": {
        "status": {"const": "verified"},
        "absolute_value_tolerance": {"type": "number", "minimum": 0},
        "maximum_absolute_value_difference": {"type": "number", "minimum": 0},
        "weighted_depth_area_by_support": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {"type": "number"}
          }
        }
      }
    }
  }
}
