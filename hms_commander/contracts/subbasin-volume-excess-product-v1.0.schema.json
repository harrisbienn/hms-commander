{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hms-commander/subbasin-volume-excess-product/1.0",
  "title": "HMS Commander subbasin volume excess product 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "forecast_eligible",
    "method",
    "algorithm",
    "transfer_map_sha256",
    "source",
    "audit",
    "output",
    "volume",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {"const": "hms-commander/subbasin-volume-excess-product/1.0"},
    "status": {"const": "qualification_only"},
    "forecast_eligible": {"const": false},
    "method": {"const": "hms-subbasin-volume-conserving-v1"},
    "algorithm": {
      "const": "target-center-subbasin-coverage-effective-area-scaling-v1"
    },
    "transfer_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object"},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size_bytes", "sha256", "audit_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "audit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size_bytes",
        "sha256",
        "pathname_selector",
        "record_count",
        "first_pathname",
        "last_pathname",
        "start",
        "end",
        "interval_minutes",
        "units",
        "data_type"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pathname_selector": {"type": "string", "minLength": 7},
        "record_count": {"type": "integer", "minimum": 1},
        "first_pathname": {"type": "string", "minLength": 1},
        "last_pathname": {"type": "string", "minLength": 1},
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1},
        "interval_minutes": {"type": "integer", "minimum": 1},
        "units": {"enum": ["IN", "MM"]},
        "data_type": {"const": "PER-CUM"}
      }
    },
    "volume": {"type": "object"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
