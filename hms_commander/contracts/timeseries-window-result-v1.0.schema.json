{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hms-commander/timeseries-window-result/1.0",
  "title": "HMS Commander time-series window result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "operation_id",
    "request_sha256",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "hms-commander/timeseries-window-result/1.0"},
    "status": {"enum": ["succeeded", "failed"]},
    "operation_id": {"type": ["string", "null"]},
    "request_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "qualification": {"type": "object"},
    "reuse_disposition": {"type": "string"},
    "source_window": {"type": "object"},
    "target_window": {"type": "object"},
    "translation_offset_seconds": {"type": "integer"},
    "output_dss": {"type": "object"},
    "series": {"type": "array", "items": {"type": "object"}},
    "classification": {"type": "string"},
    "error": {"type": "object"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
